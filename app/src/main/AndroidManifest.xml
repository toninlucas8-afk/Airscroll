<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================
         AirScroll non deve poter raggiungere la rete. Punto.

         Non basta non scrivere codice di rete: alcune librerie dichiarano il
         permesso INTERNET nel proprio manifest, e la fusione dei manifest lo
         porta dentro l'APK anche se noi non l'abbiamo mai chiesto. E' quello
         che stava succedendo fino alla 0.5.0: il codice non apriva una
         connessione, ma l'app *poteva* farlo.

         Un permesso e' una possibilita', e "non lo usiamo" e' una promessa.
         Toglierlo lo rende una proprieta' verificabile: senza INTERNET,
         Android non permette di aprire un socket, e chiunque puo' controllarlo
         guardando i permessi dell'app.

         `tools:node="remove"` lo elimina dal manifest fuso, qualunque libreria
         lo abbia chiesto. `tools/verify_apk.py` fallisce se un giorno
         ricomparisse.
         ================================================================ -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Vede la mano. Le immagini restano nel processo e non vengono mai salvate. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Sente i comandi vocali. Il microfono si apre solo dopo la V con due
         dita, per pochi secondi, e il riconoscimento avviene sul telefono:
         senza il permesso INTERNET l'audio non potrebbe uscire nemmeno
         volendo. Il permesso e' facoltativo: senza, tutto il resto
         funziona. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Il servizio in primo piano e' l'unico modo legittimo di usare la
         fotocamera mentre l'utente e' dentro un'altra app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Il pallino di stato sopra le altre app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Feedback tattile su avvio e stop. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Serve solo a sapere che il telefono e' stato riavviato, per dire una
         cosa vera invece di una sbagliata: AirScroll non riparte da solo, e
         il ricevitore non accende niente. Mostra una notifica e basta. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Solo per aprire la schermata di sistema: senza, molti telefoni chiudono
         il servizio dopo pochi minuti. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Da Android 11 un'app non vede le altre app installate se non le
         nomina qui. Senza questo elenco, "apri Spotify" non troverebbe
         Spotify: `getLaunchIntentForPackage` restituisce null e basta,
         senza errori e senza spiegazioni.

         E' un elenco chiuso, non `QUERY_ALL_PACKAGES`: AirScroll puo'
         vedere solo le app che sa aprire, non l'elenco di cio' che hai
         installato. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.google.android.apps.maps" />

        <!-- Il riconoscitore vocale su dispositivo e' un servizio di
             sistema: senza questa dichiarazione non lo si puo' nemmeno
             interrogare per sapere se esiste. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AirScrollApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AirScroll">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AirScroll">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Su Android 12 e precedenti e' appcompat a ricordare la lingua
             scelta: questo servizio disabilitato e' il posto dove la annota. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Serve a consegnare due tipi di file a un'altra app: il CSV del
             laboratorio e i due documenti PDF. Android non permette di passare
             direttamente il percorso di un file, ne' quello di un asset. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.recordings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.VisionForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Non avvia il servizio: annota il riavvio e mostra una notifica.
             Vedi BootReceiver. -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.AirScrollAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
